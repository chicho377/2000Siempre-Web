{
  "headers": [
    {
      "source": "/(.*).mov",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/quicktime"
        }
      ]
    },
    {
      "source": "/(.*).webm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/webm"
        }
      ]
    }
  ]
}
